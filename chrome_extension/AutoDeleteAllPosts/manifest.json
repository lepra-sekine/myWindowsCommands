{
  "manifest_version": 3,
  "name": "Auto Delete All Posts",
  "version": "1.0.0",
  "description": "【重要】ログイン中のアカウントの投稿を全件削除します。取り消し不可の操作です。導入・実行前に必ず対象アカウントを確認してください。",
  "permissions": ["storage"],
  "host_permissions": [
    "https://twitter.com/*",
    "https://x.com/*",
    "https://www.twitter.com/*",
    "https://www.x.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://twitter.com/*",
        "https://x.com/*",
        "https://www.twitter.com/*",
        "https://www.x.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
